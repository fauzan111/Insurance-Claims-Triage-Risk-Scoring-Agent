# Copy to .env and fill in. Never commit real secrets.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Database (multi-tenant)
DATABASE_URL=postgresql+psycopg2://agent:agent@localhost:5432/agentdb

# Async workers
REDIS_URL=redis://localhost:6379/0

# LLM. Blank ANTHROPIC_API_KEY = offline template reasoning (the fraud model
# still runs; it's a trained classifier, not the LLM).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Fraud classifier — fixed seed for a reproducible trained model.
FRAUD_MODEL_SEED=42
FRAUD_HIGH_THRESHOLD=0.60
FRAUD_REVIEW_THRESHOLD=0.30

# Auth
JWT_SECRET=dev-only-change-me
